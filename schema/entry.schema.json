{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scamdb.dev/schema/entry.schema.json",
  "title": "scamdb entry",
  "type": "object",
  "required": ["id", "country", "status", "channels", "sender", "name", "how", "steps", "examples", "phrases", "signals", "redFlags", "whatToDo", "reportTo", "sources", "updated"],
  "additionalProperties": false,
  "$defs": {
    "channel": { "enum": ["whatsapp", "sms", "phone", "online", "in-person", "email", "social"] }
  },
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]{2}/[a-z0-9]+(-[a-z0-9]+)*$" },
    "country": { "type": "string", "pattern": "^[a-z]{2}$" },
    "status": { "enum": ["active", "fading", "archived"] },
    "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/channel" } },
    "sender": { "$ref": "text.schema.json#/$defs/text" },
    "name": { "$ref": "text.schema.json#/$defs/text" },
    "how": { "$ref": "text.schema.json#/$defs/text" },
    "steps": { "type": "array", "minItems": 2, "items": {
      "type": "object", "required": ["text"], "additionalProperties": false,
      "properties": { "text": { "$ref": "text.schema.json#/$defs/text" }, "signal": { "type": "string" } } } },
    "examples": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["text"], "additionalProperties": false,
      "properties": { "text": { "$ref": "text.schema.json#/$defs/text" }, "channel": { "$ref": "#/$defs/channel" } } } },
    "phrases": { "$ref": "text.schema.json#/$defs/textList" },
    "signals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "redFlags": { "$ref": "text.schema.json#/$defs/textList" },
    "whatToDo": { "$ref": "text.schema.json#/$defs/textList" },
    "story": { "$ref": "text.schema.json#/$defs/text" },
    "media": { "type": "array", "items": {
      "type": "object", "required": ["type", "url", "title", "publisher", "date"], "additionalProperties": false,
      "properties": {
        "type": { "enum": ["video", "audio", "image", "article", "post"] },
        "url": { "$ref": "text.schema.json#/$defs/https" },
        "title": { "type": "string", "minLength": 1 }, "publisher": { "type": "string", "minLength": 1 },
        "date": { "$ref": "text.schema.json#/$defs/date" } } } },
    "reportTo": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2}/[a-z0-9-]+$" } },
    "sources": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["title", "publisher", "url", "date"], "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 }, "publisher": { "type": "string", "minLength": 1 },
        "url": { "$ref": "text.schema.json#/$defs/https" }, "date": { "$ref": "text.schema.json#/$defs/date" } } } },
    "related": { "type": "array", "items": { "type": "string" } },
    "firstSeen": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "updated": { "$ref": "text.schema.json#/$defs/date" }
  }
}
