{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scamdb.dev/schema/signals.schema.json",
  "type": "object", "required": ["signals"], "additionalProperties": false,
  "properties": { "signals": { "type": "array", "minItems": 1, "items": {
    "type": "object", "required": ["id", "label", "description"], "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z_]+$" },
      "label": { "allOf": [ { "$ref": "text.schema.json#/$defs/text" }, { "required": ["en", "es"] } ] },
      "description": { "$ref": "text.schema.json#/$defs/text" } } } } }
}
