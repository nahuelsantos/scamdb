{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scamdb.dev/schema/text.schema.json",
  "$defs": {
    "text": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "textList": {
      "type": "object", "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "https": { "type": "string", "pattern": "^https://" }
  }
}
