// Cloudflare Workers: static assets for everything, plus a small Worker that runs ONLY on the dynamic paths in
// assets.run_worker_first (reports, keys, sign-in). Static reads never wake it, so they never count against the free quota.
// `npm run build && npx wrangler deploy` publishes dist/ and worker/.
{
  "name": "scamdb",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "scamdb.dev", "custom_domain": true },
    { "pattern": "www.scamdb.dev", "custom_domain": true }
  ],
  // UAT: every non-production branch gets a Preview (Workers Builds runs `npx wrangler preview`). Previews use their own
  // test database, never production's. No routes or crons here: those only target production. See docs/uat.md.
  "preview_urls": true,
  "previews": {
    "vars": { "ENVIRONMENT": "uat" },
    "ai": { "binding": "AI" },
    "d1_databases": [
      { "binding": "DB", "database_name": "scamdb-uat", "database_id": "a609b476-6dde-4909-b1e2-f29d9783c12f", "migrations_dir": "migrations" }
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/reports", "/v1/isitascam", "/v1/feed/*", "/v1/trends", "/v1/keys*", "/v1/collect", "/v1/collect/*", "/v1/review/*", "/auth/*"]
  },
  // Workers AI (free daily allowance) scores keyed /v1/isitascam checks; keyless checks never use it.
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "scamdb", "database_id": "9ef66ac7-6bce-4190-b6c5-2ab1366fca7a", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["17 4 * * *"] }
}
