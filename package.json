{
  "name": "scamdb",
  "private": true,
  "type": "module",
  "description": "scamdb: an open database of scam patterns, country by country. Data CC BY 4.0, code MIT.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "test": "node --test tests/unit/*.test.mjs && node --test tests/worker/*.test.mjs",
    "build": "node tools/build.mjs",
    "e2e": "playwright test --trace off",
    "reports": "node tools/reports.mjs",
    "eval": "node tools/eval.mjs",
    "serve": "npm run build && node tools/serve.mjs dist 8080"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "1.63.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "miniflare": "^4.20260730.0",
    "playwright": "1.63.0",
    "roughjs": "^4.6.6",
    "wrangler": "^4"
  }
}
